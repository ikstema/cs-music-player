{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default app window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "native-audio:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/ikstema/cs-music-player/releases/download/**" }]
    }
  ]
}
